{
  "name": "edion",
  "productName": "Edion",
  "version": "0.1.0",
  "description": "A sleek, cross-platform video editor",
  "main": "./out/main/index.js",
  "author": "Lucas Ion <lucasion@hotmail.com>",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:export": "electron-vite build && node scripts/golden-export.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\" \"scripts/**\" \"*.ts\"",
    "dist": "pnpm build && electron-builder"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "immer": "^11.1.18",
    "lucide-react": "^1.47.0",
    "mediabunny": "^1.58.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.12.4",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/ffprobe-static": "^2.0.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  }
}
